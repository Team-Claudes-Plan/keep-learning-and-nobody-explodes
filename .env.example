# Copy to .env and fill in. Read by docker compose and by the Nix dev stack (`nix run .#dev`).

# Required: OpenAI-compatible LLM endpoint for Akasha.
export LLM_API_KEY=
export LLM_BASE_URL=https://openrouter.ai/api/v1
export LLM_MODEL=deepseek/deepseek-v4.1-flash-1017

# Nix dev stack only (docker compose builds its own).
export DATABASE_URL=postgres://postgres@localhost:5432/upload

# Optional for docker compose; the defaults work out of the box.
# export HTTP_PORT=8080               # frontend port on the host
# export BIND_ADDRESS=127.0.0.1       # 0.0.0.0 to reach it from other machines
# export AKASHA_LANGUAGE=german       # or english
# export POSTGRES_PASSWORD=postgres   # internal secrets: change them for a public host,
# export S3_ACCESS_KEY=keep-learning  # before the first start
# export S3_SECRET_KEY=keep-learning-secret
# export WEBHOOK_TOKEN=keep-learning-webhook
