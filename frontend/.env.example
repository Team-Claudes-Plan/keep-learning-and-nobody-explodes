# Copy to .env.local and adjust. Without VITE_API_URL the app uses mock data (src/api/mock.ts).

# Option A: talk to the backend directly (backend must allow CORS).
# VITE_API_URL=http://localhost:8080

# Option B (dev): go through the Vite proxy, no CORS needed.
# VITE_API_URL=/api
# API_PROXY_TARGET=http://localhost:8080
