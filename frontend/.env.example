# Copy to .env.local and adjust. Without VITE_API_URL the app uses mock data (src/api/mock*.ts).

# Option A: talk to the backend directly (the backend does not send CORS headers yet).
# VITE_API_URL=http://localhost:8081

# Option B (dev): go through the Vite proxy, no CORS needed.
# VITE_API_URL=/backend
# API_PROXY_TARGET=http://localhost:8081

# Optional: play as this user (an id from PUT /api/users/create) instead of signing in.
# VITE_USER_ID=
