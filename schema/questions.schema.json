{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questions.schema.json",
  "title": "Questions",
  "description": "List of questions as delivered by the backend, including correct answers.",
  "type": "array",
  "items": { "$ref": "#/$defs/question" },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "textList": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "indexList": { "type": "array", "items": { "type": "integer", "minimum": 0 } },

    "question": {
      "type": "object",
      "required": ["type", "correct_answer"],
      "properties": {
        "type": {
          "enum": [
            "single_choice",
            "multiple_choice",
            "true_false",
            "text_input",
            "number_input",
            "matching",
            "grouping",
            "coords",
            "order"
          ]
        }
      },
      "oneOf": [
        { "$ref": "#/$defs/single_choice" },
        { "$ref": "#/$defs/multiple_choice" },
        { "$ref": "#/$defs/true_false" },
        { "$ref": "#/$defs/text_input" },
        { "$ref": "#/$defs/number_input" },
        { "$ref": "#/$defs/matching" },
        { "$ref": "#/$defs/grouping" },
        { "$ref": "#/$defs/coords" },
        { "$ref": "#/$defs/order" }
      ]
    },

    "single_choice": {
      "description": "Player picks exactly one option.",
      "type": "object",
      "required": ["type", "prompt", "options", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "single_choice" },
        "prompt": { "$ref": "#/$defs/text" },
        "options": { "$ref": "#/$defs/textList", "type": "array", "minItems": 2, "maxItems": 6 },
        "correct_answer": { "type": "integer", "minimum": 0 }
      }
    },

    "multiple_choice": {
      "description": "Player picks one or more options.",
      "type": "object",
      "required": ["type", "prompt", "options", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "multiple_choice" },
        "prompt": { "$ref": "#/$defs/text" },
        "options": { "$ref": "#/$defs/textList", "type": "array", "minItems": 2, "maxItems": 8 },
        "correct_answer": { "$ref": "#/$defs/indexList", "minItems": 1, "uniqueItems": true }
      }
    },

    "true_false": {
      "description": "Player rates each statement as true or false.",
      "type": "object",
      "required": ["type", "statements", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "true_false" },
        "statements": { "$ref": "#/$defs/textList", "type": "array", "minItems": 1 },
        "correct_answer": { "type": "array", "items": { "type": "boolean" }, "minItems": 1 }
      }
    },

    "text_input": {
      "description": "Player types a free-text answer.",
      "type": "object",
      "required": ["type", "prompt", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "text_input" },
        "prompt": { "$ref": "#/$defs/text" },
        "caseSensitive": {
          "description": "Default false: case is ignored and the frontend sends the input in upper case.",
          "type": "boolean",
          "default": false
        },
        "correct_answer": { "$ref": "#/$defs/text" }
      }
    },

    "number_input": {
      "description": "Player enters a number, optionally with a unit shown next to the input.",
      "type": "object",
      "required": ["type", "prompt", "unit", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "number_input" },
        "prompt": { "$ref": "#/$defs/text" },
        "unit": { "type": ["string", "null"] },
        "correct_answer": { "type": "number" }
      }
    },

    "matching": {
      "description": "Player connects each left element with a right element. Correct answers are 0-based indices into the right array.",
      "type": "object",
      "required": ["type", "left", "right", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "matching" },
        "left": { "$ref": "#/$defs/textList", "type": "array", "minItems": 2, "maxItems": 8 },
        "right": { "$ref": "#/$defs/textList", "type": "array", "minItems": 2, "maxItems": 8 },
        "correct_answer": { "$ref": "#/$defs/indexList", "minItems": 2 }
      }
    },

    "grouping": {
      "description": "Player sorts items into categories.",
      "type": "object",
      "required": ["type", "categories", "items", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "grouping" },
        "categories": { "$ref": "#/$defs/textList", "type": "array", "minItems": 2, "maxItems": 4 },
        "items": { "$ref": "#/$defs/textList", "type": "array", "minItems": 2, "maxItems": 12 },
        "correct_answer": { "$ref": "#/$defs/indexList", "minItems": 1 }
      }
    },

    "coords": {
      "description": "Player clicks a position in the image.",
      "type": "object",
      "required": ["type", "prompt", "image", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "coords" },
        "prompt": { "$ref": "#/$defs/text" },
        "image": { "type": "string", "format": "uri" },
        "correct_answer": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    },

    "order": {
      "description": "Player puts the items in the correct order.",
      "type": "object",
      "required": ["type", "prompt", "items", "correct_answer"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "order" },
        "prompt": { "$ref": "#/$defs/text" },
        "items": { "$ref": "#/$defs/textList", "type": "array", "minItems": 3, "maxItems": 8 },
        "correct_answer": { "$ref": "#/$defs/indexList", "minItems": 1, "uniqueItems": true }
      }
    }
  }
}
